# Copy to .env. Without a key, Wisp runs in demo mode with a scripted brain.
ANTHROPIC_API_KEY=
# OPENAI_API_KEY=

# Model for Wisp's brain (Claude Opus 5.5 by default) and its effort level.
WISP_MODEL=claude-opus-5-5
WISP_EFFORT=low

# Fully local: Ollama vision model, nothing leaves the machine.
# WISP_LOCAL_MODE=true
# WISP_LOCAL_MODEL=qwen2.5vl:7b

# Voice: kokoro (local CPU), chatterbox (local GPU, pip install -e ".[chatterbox]"), client (OS voice)
WISP_VOICE__TTS=kokoro
WISP_VOICE__VOICE=af_heart

# Budgets
WISP_BUDGET__MAX_COST_USD=0.25
WISP_BUDGET__DAILY_COST_USD=5.0
