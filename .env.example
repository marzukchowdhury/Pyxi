# Copy to .env. Without a key, Pyxi runs in demo mode with a scripted brain.
ANTHROPIC_API_KEY=
# OPENAI_API_KEY=

# OpenRouter: one key for Claude, Gemini, GPT and more. Use OpenRouter ids as model names:
# OPENROUTER_API_KEY=
# PYXI_MODEL=anthropic/claude-haiku-5.5
# PYXI_JOB_MODEL=anthropic/claude-sonnet-5.5

# Model for Pyxi's brain (Claude Opus 5.5 by default) and its effort level.
PYXI_MODEL=claude-opus-5-5
PYXI_EFFORT=low

# Fully local: Ollama vision model, nothing leaves the machine.
# PYXI_LOCAL_MODE=true
# PYXI_LOCAL_MODEL=qwen2.5vl:7b

# Voice: kokoro (local CPU), chatterbox (local GPU, pip install -e ".[chatterbox]"), client (OS voice)
PYXI_VOICE__TTS=kokoro
PYXI_VOICE__VOICE=af_heart

# Budgets
PYXI_BUDGET__MAX_COST_USD=0.25
PYXI_BUDGET__DAILY_COST_USD=5.0
