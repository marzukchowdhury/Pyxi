# Copy to .env. Without a key, Blip runs in demo mode with a scripted brain.
ANTHROPIC_API_KEY=
# OPENAI_API_KEY=

# OpenRouter: one key for Claude, Gemini, GPT and more. Use OpenRouter ids as model names:
# OPENROUTER_API_KEY=
# BLIP_MODEL=anthropic/claude-haiku-5.5
# BLIP_JOB_MODEL=anthropic/claude-sonnet-5.5

# Model for Blip's brain (Claude Opus 5.5 by default) and its effort level.
BLIP_MODEL=claude-opus-5-5
BLIP_EFFORT=low

# Fully local: Ollama vision model, nothing leaves the machine.
# BLIP_LOCAL_MODE=true
# BLIP_LOCAL_MODEL=qwen2.5vl:7b

# Voice: kokoro (local CPU), chatterbox (local GPU, pip install -e ".[chatterbox]"), client (OS voice)
BLIP_VOICE__TTS=kokoro
BLIP_VOICE__VOICE=af_heart

# Budgets
BLIP_BUDGET__MAX_COST_USD=0.25
BLIP_BUDGET__DAILY_COST_USD=5.0
