{
  "name": "pyxi-desktop",
  "version": "0.1.9",
  "private": true,
  "description": "Pyxi desktop shell: transparent overlay, 3D explanation layer and control panel.",
  "main": "out/main/index.js",
  "author": "Marzuk Haider Chowdhury",
  "license": "MIT",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "start": "electron-vite preview",
    "web": "vite --config vite.web.config.ts",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "dist": "electron-builder --win nsis --publish never"
  },
  "dependencies": {
    "electron-updater": "^6.8.11",
    "uiohook-napi": "^1.5.5"
  },
  "devDependencies": {
    "@fontsource/caveat": "^5.3.0",
    "@fontsource/fraunces": "^5.3.0",
    "@fontsource/inter": "^5.3.0",
    "@fortawesome/free-brands-svg-icons": "^7.3.1",
    "@react-three/drei": "^10.7.9",
    "@react-three/fiber": "^9.8.2",
    "@react-three/postprocessing": "^3.2.2",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/three": "^0.187.0",
    "@vitejs/plugin-react": "^6.2.1",
    "electron": "^45.2.3",
    "electron-builder": "^26.18.0",
    "electron-vite": "^6.0.0",
    "playwright-core": "^1.65.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "three": "^0.187.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.6",
    "vitest": "^5.1.0",
    "zustand": "^5.0.16"
  },
  "productName": "Pyxi",
  "build": {
    "appId": "app.pyxi.desktop",
    "productName": "Pyxi",
    "copyright": "Copyright 2026 Marzuk Haider Chowdhury",
    "directories": {
      "output": "dist",
      "buildResources": "resources"
    },
    "files": [
      "out/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "build/python",
        "to": "python",
        "filter": [
          "**/*"
        ]
      }
    ],
    "asarUnpack": [
      "**/node_modules/uiohook-napi/**"
    ],
    "win": {
      "target": "nsis",
      "icon": "resources/icon.ico",
      "signExecutable": false
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": false,
      "artifactName": "Pyxi-Setup.exe",
      "shortcutName": "Pyxi",
      "uninstallDisplayName": "Pyxi",
      "deleteAppDataOnUninstall": false,
      "include": "resources/installer.nsh"
    },
    "npmRebuild": false,
    "publish": [
      {
        "provider": "github",
        "owner": "marzukchowdhury",
        "repo": "Pyxi",
        "releaseType": "release"
      }
    ],
    "compression": "maximum",
    "electronLanguages": [
      "en-US"
    ]
  }
}
