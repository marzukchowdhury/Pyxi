<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  Pyxi's entitlements under the hardened runtime (only in force once the app is signed with a
  Developer ID; see docs/MAC-PORT.md). Pyxi is not sandboxed: it reads other apps' windows
  through Accessibility, which the App Sandbox doesn't allow.
-->
<plist version="1.0">
<dict>
  <!-- Electron's JavaScript engine compiles code as it runs. -->
  <key>com.apple.security.cs.allow-jit</key>
  <true/>
  <key>com.apple.security.cs.allow-unsigned-executable-memory</key>
  <true/>
  <!-- The bundled Python loads native modules (numpy, onnxruntime, pyobjc) that aren't signed
       by Pyxi's team. -->
  <key>com.apple.security.cs.disable-library-validation</key>
  <true/>
  <!-- Talking to Pyxi. -->
  <key>com.apple.security.device.audio-input</key>
  <true/>
  <!-- Asking Safari for its address, Spotify to play a song (macOS asks the user first). -->
  <key>com.apple.security.automation.apple-events</key>
  <true/>
</dict>
</plist>
