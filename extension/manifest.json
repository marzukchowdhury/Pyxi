{
  "manifest_version": 3,
  "name": "Pyxi in your browser",
  "short_name": "Pyxi",
  "version": "0.2.0",
  "description": "Lets Pyxi, the desktop buddy on this PC, read and work in the tabs you choose, without taking your mouse.",
  "minimum_chrome_version": "116",
  "icons": {
    "16": "icons/pyxi-16.png",
    "32": "icons/pyxi-32.png",
    "48": "icons/pyxi-48.png",
    "128": "icons/pyxi-128.png"
  },
  "action": {
    "default_title": "Pyxi",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/pyxi-16.png",
      "32": "icons/pyxi-32.png"
    }
  },
  "background": {
    "service_worker": "background.js"
  },
  "permissions": ["activeTab", "scripting", "storage", "alarms"],
  "optional_permissions": ["tabs"],
  "optional_host_permissions": ["http://*/*", "https://*/*"],
  "incognito": "not_allowed",
  "content_security_policy": {
    "extension_pages": "default-src 'self'; script-src 'self'; object-src 'none'; connect-src ws://127.0.0.1:*"
  }
}
